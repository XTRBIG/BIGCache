# Attach one export as /dev/nbdN. Usage:
#   systemctl enable --now bigcache-attach@media:nbd0.service
# (the instance name is EXPORT:DEVICE)
[Unit]
Description=Attach BIGCache export %i
Requires=bigcache.service
After=bigcache.service

[Service]
Type=simple
ExecStartPre=/sbin/modprobe nbd max_part=16
ExecStart=/bin/sh -c 'set -- $(echo "%i" | tr : " "); exec /usr/local/bin/bigcache attach "$1" "/dev/$2"'
ExecStop=/bin/sh -c 'set -- $(echo "%i" | tr : " "); /usr/local/bin/bigcache detach "/dev/$2"'
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
